{
  "color-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Page background."
  },
  "color-surface": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.961, 0.969, 0.98], "hex": "#f5f7fa" },
    "$description": "Background for cards and panels raised above the page."
  },
  "color-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.102, 0.122, 0.161], "hex": "#1a1f29" },
    "$description": "Primary text, meets WCAG AA (4.5:1) against color-bg."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.357, 0.392, 0.447], "hex": "#5b6472" },
    "$description": "Secondary text: timestamps, helper text, field labels."
  },
  "color-border": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.843, 0.863, 0.89], "hex": "#d7dce3" },
    "$description": "Dividers, card and input borders."
  },
  "color-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563eb" },
    "$description": "Primary actions and links."
  },
  "color-primary-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Text/icons placed on a color-primary surface."
  },
  "color-success": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.082, 0.502, 0.239], "hex": "#15803d" },
    "$description": "Approved/completed status text."
  },
  "color-success-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.902, 0.957, 0.918], "hex": "#e6f4ea" },
    "$description": "Background tint for approved/completed status chips."
  },
  "color-warning": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.706, 0.325, 0.035], "hex": "#b45309" },
    "$description": "Pending/in-review status text."
  },
  "color-warning-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.996, 0.953, 0.886], "hex": "#fef3e2" },
    "$description": "Background tint for pending/in-review status chips."
  },
  "color-danger": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.725, 0.11, 0.11], "hex": "#b91c1c" },
    "$description": "Rejected/error status text and destructive actions."
  },
  "color-danger-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.992, 0.918, 0.918], "hex": "#fdeaea" },
    "$description": "Background tint for rejected/error status chips."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Tightest spacing: icon-to-label gaps."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Spacing within a control, e.g. button padding-block."
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Spacing between related controls in a row."
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Default padding inside cards and panels."
  },
  "space-5": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Gaps between cards/sections within a page."
  },
  "space-6": {
    "$type": "dimension",
    "$value": { "value": 32, "unit": "px" },
    "$description": "Page-level margins and major section breaks."
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Inputs, chips."
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Buttons."
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Cards and panels."
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "$description": "Default typeface for all UI text."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400,
    "$description": "Body text."
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600,
    "$description": "Headings, button labels, field labels."
  },
  "line-height-base": {
    "$type": "number",
    "$value": 1.5,
    "$description": "Default line-height for body copy."
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Helper text, table meta, chip labels."
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" },
    "$description": "Default body and control text."
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 18, "unit": "px" },
    "$description": "Card titles, section headings."
  },
  "font-size-xl": {
    "$type": "dimension",
    "$value": { "value": 22, "unit": "px" },
    "$description": "Page titles."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Primary (default) button background."
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}",
    "$description": "Primary button label/icon color."
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}",
    "$description": "Primary button corner radius."
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Secondary button background."
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Secondary button label/icon color."
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Secondary button border color."
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}",
    "$description": "Card surface background."
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Card border color."
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}",
    "$description": "Card corner radius."
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}",
    "$description": "Card inner padding."
  },
  "chip-success-background": {
    "$type": "color",
    "$value": "{color-success-bg}",
    "$description": "Approved/completed status chip background."
  },
  "chip-success-foreground": {
    "$type": "color",
    "$value": "{color-success}",
    "$description": "Approved/completed status chip text."
  },
  "chip-warning-background": {
    "$type": "color",
    "$value": "{color-warning-bg}",
    "$description": "Pending/in-review status chip background."
  },
  "chip-warning-foreground": {
    "$type": "color",
    "$value": "{color-warning}",
    "$description": "Pending/in-review status chip text."
  },
  "chip-danger-background": {
    "$type": "color",
    "$value": "{color-danger-bg}",
    "$description": "Rejected/error status chip background."
  },
  "chip-danger-foreground": {
    "$type": "color",
    "$value": "{color-danger}",
    "$description": "Rejected/error status chip text."
  },
  "input-default-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Form control background."
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Form control border, default and resting state."
  },
  "input-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Form control text color."
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}",
    "$description": "Form control corner radius."
  }
}
